# Gate statutes: deterministic tool-call refusal (claude harness today).
# Copy into <base_dir>/identity/rails/ and restart the substrate to apply.
# A statute change regenerates homes — sessions there lose model memory,
# visibly (the context-reset marker shows where).

[[statute]]
name = "no-history-rewrites"
on = "tool-call"
tool = "Bash"
pattern = "git (reset|stash|rebase|checkout \\.|restore|clean)"
text = "History-rewriting git commands are forbidden here: other agents may have uncommitted work in this tree."

[[statute]]
name = "no-push-main"
on = "tool-call"
tool = "Bash"
pattern = "git push[^&|;]*\\b(main|master)\\b"
text = "Pushing to main is forbidden: work lands on branches; the operator merges."
