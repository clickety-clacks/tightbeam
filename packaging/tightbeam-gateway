#!/bin/sh
# Launches the bundled BEAM release in the foreground, exactly like the README's
# `mix run --no-halt` — same env contract (TIGHTBEAM_BASE_DIR, TIGHTBEAM_PORT, ...),
# no service-manager opinions (launchd/systemd stay README guidance, per ruling).
#
# npm exposes bins as SYMLINKS in node_modules/.bin, so $0's directory is the symlink's
# home, not the package's. Resolve the link first — measured failure, not speculation:
# the unresolved form exec'd node_modules/release/... which does not exist.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

# ONE ERLANG NODE NAME PER INSTANCE, DERIVED FROM THE PORT.
#
# A mix release names its node after the RELEASE, so every instance on a machine
# claimed `tightbeam_gateway@<host>` and the second one refused to boot with
#
#   Protocol 'inet_tcp': the name tightbeam_gateway@eezo seems to be in use by
#   another Erlang node
#
# — a message naming no port, no base dir, and nothing an operator would connect to
# Tightbeam. Nothing in the product prevents two gateways coexisting; only this
# default did. The port is the right discriminator because two instances need
# different ports anyway, so a collision here means a collision there too, reported
# by whichever notices first.
#
# `TIGHTBEAM_NODE` overrides it for anyone who wants a name of their own; an explicit
# `RELEASE_NODE` still wins, since that is the release runtime's own knob and this
# script has no business overruling it.
if [ -z "${RELEASE_NODE:-}" ]; then
  if [ -n "${TIGHTBEAM_NODE:-}" ]; then
    RELEASE_NODE="$TIGHTBEAM_NODE"
  else
    RELEASE_NODE="tightbeam_gateway_${TIGHTBEAM_PORT:-11373}"
  fi
  export RELEASE_NODE
fi

# KEEP THE DISTRIBUTION COOKIE OUTSIDE THE REPLACEABLE PACKAGE.
#
# Mix generates a random `release/releases/COOKIE` for every clean release build.
# An npm upgrade replaces that file while the old BEAM is still running.  The new
# `stop` command then has the right node name but the wrong cookie, so it reports
# `nodedown` and cannot ask the old release to run its graceful `prep_stop` path.
#
# An explicit RELEASE_COOKIE remains authoritative.  Otherwise the first launch
# copies the package cookie into the org's durable base dir with mode 0600.  Every
# later command reads that same file, including commands from a newer package.
if [ -z "${RELEASE_COOKIE:-}" ]; then
  if [ "${TIGHTBEAM_BASE_DIR+x}" = x ]; then
    COOKIE_BASE="$TIGHTBEAM_BASE_DIR"
  elif [ "${TIGHTBEAM_HOME+x}" = x ]; then
    COOKIE_BASE="$TIGHTBEAM_HOME"
  elif [ "${HOME+x}" = x ]; then
    COOKIE_BASE="$HOME/.tightbeam"
  else
    echo "tightbeam-gateway: cannot resolve the base dir for the release cookie" >&2
    echo "Set TIGHTBEAM_BASE_DIR, TIGHTBEAM_HOME, HOME, or RELEASE_COOKIE." >&2
    exit 1
  fi

  case "$COOKIE_BASE" in
    "") COOKIE_FILE="release.cookie" ;;
    *) COOKIE_FILE="$COOKIE_BASE/release.cookie" ;;
  esac

  if [ ! -f "$COOKIE_FILE" ]; then
    PACKAGED_COOKIE_FILE="$DIR/release/releases/COOKIE"
    if [ ! -f "$PACKAGED_COOKIE_FILE" ]; then
      echo "tightbeam-gateway: package has no release cookie at $PACKAGED_COOKIE_FILE" >&2
      exit 1
    fi

    if [ -n "$COOKIE_BASE" ]; then
      mkdir -p "$COOKIE_BASE"
    fi
    COOKIE_TEMP="$COOKIE_FILE.tmp.$$"
    trap 'rm -f "$COOKIE_TEMP"' EXIT HUP INT TERM
    umask 077
    cp "$PACKAGED_COOKIE_FILE" "$COOKIE_TEMP"
    chmod 600 "$COOKIE_TEMP"

    # `ln` is the no-overwrite commit.  Two simultaneous first launches either
    # publish the same package cookie or one reads the complete file the other won.
    if ln "$COOKIE_TEMP" "$COOKIE_FILE" 2>/dev/null; then
      :
    elif [ ! -f "$COOKIE_FILE" ]; then
      echo "tightbeam-gateway: could not persist release cookie at $COOKIE_FILE" >&2
      exit 1
    fi
    rm -f "$COOKIE_TEMP"
    trap - EXIT HUP INT TERM
  fi

  if [ -L "$COOKIE_FILE" ]; then
    echo "tightbeam-gateway: release cookie must not be a symlink: $COOKIE_FILE" >&2
    exit 1
  fi
  if ! chmod 600 "$COOKIE_FILE"; then
    echo "tightbeam-gateway: could not secure release cookie at $COOKIE_FILE" >&2
    exit 1
  fi

  RELEASE_COOKIE=$(cat "$COOKIE_FILE")
  case "$RELEASE_COOKIE" in
    "" | *[!A-Za-z0-9_=]*)
      echo "tightbeam-gateway: invalid release cookie at $COOKIE_FILE" >&2
      exit 1
      ;;
  esac
  export RELEASE_COOKIE
fi

# EVERY release command goes through here, not just `start`. This used to exec
# `start "$@"` unconditionally, which left `stop`, `restart`, `remote`, `rpc` and `pid`
# reachable only by invoking `release/bin/tightbeam_gateway` directly — where the
# derivation above has not run, so they defaulted to the old `tightbeam_gateway` node and
# failed `nodedown` against a gateway that was plainly running. A name that only the
# start path knows is not a name.
#
# Those commands find the node by NAME, so they must resolve to the same one the gateway
# started under — which the release also qualifies with the machine name, since
# RELEASE_DISTRIBUTION defaults to `sname`.
#
# Do not restate the precedence here. Three attempts to summarise it in a sentence were
# each wrong by omission ("the same port"; then "the port or TIGHTBEAM_NODE"; then a
# three-item list that still missed the hostname), every one describing a guarantee
# narrower than the code gives. The resolution is the four lines below and the release's
# own `RELEASE_NODE="${RELEASE_NODE:-$RELEASE_NAME}"`; read those, not a paraphrase.
#
# A LEADING FLAG STILL MEANS `start`. The previous form was `start "$@"`, so
# `tightbeam-gateway --erl "+sbwt none"` passed that option to start; treating a
# leading `-` as a subcommand would answer it with `Unknown command --erl`. Only a
# bare word is a subcommand.
case "${1:-}" in
  "" | -*) set -- start "$@" ;;
esac

RELEASE_BIN="$DIR/release/bin/tightbeam_gateway"

# ERTS treats SIGINT as an interactive BREAK request, not an orderly application
# stop. Keep the foreground launcher's pid stable for service managers and map both
# supported stop signals to SIGTERM on the real VM, which runs Application.prep_stop/1.
# Other release commands stay direct execs so their exit and terminal behaviour do
# not acquire an unnecessary wrapper process.
if [ "${1:-}" = start ]; then
  "$RELEASE_BIN" "$@" &
  RELEASE_PID=$!

  graceful_stop() {
    trap - INT TERM
    "$RELEASE_BIN" stop || kill -TERM "$RELEASE_PID" 2>/dev/null || :
  }

  trap graceful_stop INT TERM
  RELEASE_STATUS=0

  while kill -0 "$RELEASE_PID" 2>/dev/null; do
    wait "$RELEASE_PID"
    RELEASE_STATUS=$?
  done

  trap - INT TERM
  exit "$RELEASE_STATUS"
fi

exec "$RELEASE_BIN" "$@"
