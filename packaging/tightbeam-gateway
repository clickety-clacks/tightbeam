#!/bin/sh
# Launches the bundled BEAM release in the foreground, exactly like the README's
# `mix run --no-halt` — same env contract (TIGHTBEAM_BASE_DIR, TIGHTBEAM_PORT, ...),
# no service-manager opinions (launchd/systemd stay README guidance, per ruling).
#
# npm exposes bins as SYMLINKS in node_modules/.bin, so $0's directory is the symlink's
# home, not the package's. Resolve the link first — measured failure, not speculation:
# the unresolved form exec'd node_modules/release/... which does not exist.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
REL="$DIR/release/bin/tightbeam_gateway"

# LIFECYCLE VERBS RESOLVE THEIR TARGET FROM $TIGHTBEAM_BASE_DIR/gateway.json ONLY.
#
# The incident this guards against: a test teardown ran `stop` in an environment
# where the production systemd unit had exported RELEASE_NODE/TIGHTBEAM_PORT to
# it. The mix release resolves `stop`/`rpc` by NODE NAME, an inherited
# RELEASE_NODE wins, and the shared Erlang cookie let the test's `stop` reach and
# halt PRODUCTION. So the incident verb no longer resolves a node at all: `stop`
# SIGTERMs the OS pid the descriptor records, identity-gated. `rpc`/`remote`
# still use distribution but take their node from the descriptor, never ambient.
#
# There is NO TIGHTBEAM_HOME fallback, NO ~/.tightbeam default, NO port-derived
# guess: an absent TIGHTBEAM_BASE_DIR or descriptor is a REFUSAL, so reaching an
# instance requires explicitly naming it.

refuse() {
  # $1: one-line reason (the verb-specific lead-in)
  printf 'tightbeam-gateway: %s\n' "$1" >&2
  printf '  Set TIGHTBEAM_BASE_DIR=<dir> for the instance you mean, or use\n' >&2
  printf '  `systemctl stop tightbeam` for the managed gateway.\n' >&2
  printf '  (The `restart` verb was removed: use `stop` then `start`, or\n' >&2
  printf '  `systemctl restart tightbeam` for the managed gateway.)\n' >&2
  exit 64
}

require_descriptor() {
  # Sets DESC_PATH to $TIGHTBEAM_BASE_DIR/gateway.json, or REFUSES ($1 = verb,
  # for the message) when TIGHTBEAM_BASE_DIR is unset or the descriptor is
  # absent. Call this DIRECTLY (never in a command substitution): `refuse`
  # exits, and an exit inside `$(...)` would only kill the subshell — the caller
  # would run on past the refusal.
  if [ -z "${TIGHTBEAM_BASE_DIR:-}" ]; then
    refuse "refusing to $1: TIGHTBEAM_BASE_DIR is not set."
  fi
  DESC_PATH="$TIGHTBEAM_BASE_DIR/gateway.json"
  if [ ! -f "$DESC_PATH" ]; then
    refuse "refusing to $1: no descriptor at $DESC_PATH."
  fi
}

# JSON field extraction. A gateway command line and an OS pid carry no
# JSON-special characters, so these bounded matches are exact; any oddity yields
# an empty result, and every caller treats empty as a REFUSAL rather than a
# guess — dirt is reported, never accommodated.
json_string() { # stdin: JSON; $1: key -> value of "key":"<value>"
  sed -n "s/.*\"$1\":\"\\([^\"]*\\)\".*/\\1/p"
}
json_number() { # stdin: JSON; $1: key -> value of "key":<digits>
  sed -n "s/.*\"$1\":\\([0-9][0-9]*\\).*/\\1/p"
}

process_command() { # $1: pid -> its current command line, or empty
  # Strip leading and trailing whitespace so this matches the descriptor's
  # ownedCommand, which gateway.ex captures with the same `ps` and String.trim.
  ps -ww -o command= -p "$1" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d'
}

do_stop() {
  require_descriptor stop
  _json="$(cat "$DESC_PATH")"
  _pid="$(printf '%s' "$_json" | json_string ownedPid)"
  _cmd="$(printf '%s' "$_json" | json_string ownedCommand)"
  if [ -z "$_pid" ] || [ -z "$_cmd" ]; then
    refuse "refusing to stop: descriptor has no ownedPid/ownedCommand (pre-upgrade or malformed)."
  fi
  _now="$(process_command "$_pid")"
  if [ -z "$_now" ]; then
    refuse "refusing to stop: owned pid $_pid is not running (already stopped)."
  fi
  if [ "$_now" != "$_cmd" ]; then
    # The pid has been recycled onto an unrelated process. Signalling it would
    # kill somebody else's work — the exact failure the identity gate prevents.
    refuse "refusing to stop: owned pid $_pid was recycled (command no longer matches the descriptor)."
  fi
  # SIGTERM triggers the same OTP graceful shutdown (prep_stop) as `systemctl
  # stop`. No node, no cookie, no restart follow-on.
  exec kill -TERM "$_pid"
}

do_pid() {
  require_descriptor pid
  _json="$(cat "$DESC_PATH")"
  _pid="$(printf '%s' "$_json" | json_string ownedPid)"
  if [ -z "$_pid" ]; then
    refuse "refusing to resolve pid: descriptor has no ownedPid (pre-upgrade or malformed)."
  fi
  printf '%s\n' "$_pid"
  exit 0
}

do_debug() { # $@: the full argv (rpc <expr> | remote)
  # rpc/remote still use Erlang distribution, but the node is read from the
  # descriptor the instance wrote at boot (R1/R4), NEVER from an ambient
  # RELEASE_NODE/TIGHTBEAM_NODE. Setting RELEASE_NODE from the descriptor makes
  # the descriptor node WIN over any inherited one — the same incident-safety
  # property `stop` has, now for the debug verbs too, and it preserves custom
  # `TIGHTBEAM_NODE` instances (their real node is in the descriptor).
  require_descriptor "$1"
  _json="$(cat "$DESC_PATH")"
  _node="$(printf '%s' "$_json" | json_string node)"
  if [ -z "$_node" ]; then
    refuse "refusing to $1: descriptor has no node (pre-upgrade or malformed)."
  fi
  RELEASE_NODE="$_node"
  export RELEASE_NODE
  # R4: rpc/remote use this install's BAKED releases/COOKIE for Phase 1 (the
  # per-instance cookie is Phase 2). The release runtime PREFERS an inherited
  # RELEASE_COOKIE over the baked file, so drop it — the release then reads
  # releases/COOKIE. This carries the incident-safety property onto the cookie
  # dimension: an inherited/prod RELEASE_COOKIE cannot authenticate rpc/remote
  # against anything but this install's own baked cookie.
  unset RELEASE_COOKIE
  exec "$REL" "$@"
}

verb="${1:-}"
case "$verb" in
  "" | -*)
    # A LEADING FLAG STILL MEANS `start`. `tightbeam-gateway --erl "+sbwt none"`
    # passes that option to start; treating a leading `-` as a subcommand would
    # answer it with `Unknown command --erl`. Only a bare word is a subcommand.
    verb=start
    ;;
esac

case "$verb" in
  stop)
    do_stop
    ;;
  pid)
    do_pid
    ;;
  restart)
    # [F1] The `restart` verb is REMOVED. A SIGTERM-then-boot restart would
    # replace a systemd-managed production with an UNMANAGED process — the exact
    # failure class this work removes. Isolated restart = `stop` then `start`;
    # production restart = `systemctl restart tightbeam`.
    printf 'tightbeam-gateway: the `restart` verb was removed.\n' >&2
    printf '  Isolated restart: run `stop` then `start`.\n' >&2
    printf '  Production restart: `systemctl restart tightbeam`.\n' >&2
    exit 64
    ;;
  rpc | remote)
    do_debug "$@"
    ;;
  *)
    # start and every other release verb (version, eval, daemon, ...) keep the
    # per-instance node name derived from the port.
    #
    # ONE ERLANG NODE NAME PER INSTANCE, DERIVED FROM THE PORT. A mix release
    # names its node after the RELEASE, so every instance on a machine claimed
    # `tightbeam_gateway@<host>` and the second refused to boot ("name ... seems
    # to be in use by another Erlang node"). The port is the right discriminator
    # because two instances need different ports anyway. `TIGHTBEAM_NODE`
    # overrides it; an explicit `RELEASE_NODE` still wins, since that is the
    # release runtime's own knob and this script has no business overruling it.
    if [ -z "${RELEASE_NODE:-}" ]; then
      if [ -n "${TIGHTBEAM_NODE:-}" ]; then
        RELEASE_NODE="$TIGHTBEAM_NODE"
      else
        RELEASE_NODE="tightbeam_gateway_${TIGHTBEAM_PORT:-11373}"
      fi
      export RELEASE_NODE
    fi
    case "${1:-}" in
      "" | -*) set -- start "$@" ;;
    esac
    exec "$REL" "$@"
    ;;
esac
