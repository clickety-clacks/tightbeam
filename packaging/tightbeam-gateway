#!/bin/sh
# Launches the bundled BEAM release in the foreground, exactly like the README's
# `mix run --no-halt` — same env contract (TIGHTBEAM_BASE_DIR, TIGHTBEAM_PORT, ...),
# no service-manager opinions (launchd/systemd stay README guidance, per ruling).
#
# npm exposes bins as SYMLINKS in node_modules/.bin, so $0's directory is the symlink's
# home, not the package's. Resolve the link first — measured failure, not speculation:
# the unresolved form exec'd node_modules/release/... which does not exist.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"

# ONE ERLANG NODE NAME PER INSTANCE, DERIVED FROM THE PORT.
#
# A mix release names its node after the RELEASE, so every instance on a machine
# claimed `tightbeam_gateway@<host>` and the second one refused to boot with
#
#   Protocol 'inet_tcp': the name tightbeam_gateway@eezo seems to be in use by
#   another Erlang node
#
# — a message naming no port, no base dir, and nothing an operator would connect to
# Tightbeam. Nothing in the product prevents two gateways coexisting; only this
# default did. The port is the right discriminator because two instances need
# different ports anyway, so a collision here means a collision there too, reported
# by whichever notices first.
#
# `TIGHTBEAM_NODE` overrides it for anyone who wants a name of their own; an explicit
# `RELEASE_NODE` still wins, since that is the release runtime's own knob and this
# script has no business overruling it.
if [ -z "${RELEASE_NODE:-}" ]; then
  if [ -n "${TIGHTBEAM_NODE:-}" ]; then
    RELEASE_NODE="$TIGHTBEAM_NODE"
  else
    RELEASE_NODE="tightbeam_gateway_${TIGHTBEAM_PORT:-4321}"
  fi
  export RELEASE_NODE
fi

# EVERY release command goes through here, not just `start`. This used to exec
# `start "$@"` unconditionally, which left `stop`, `restart`, `remote`, `rpc` and `pid`
# reachable only by invoking `release/bin/tightbeam_gateway` directly — where the
# derivation above has not run, so they defaulted to the old `tightbeam_gateway` node and
# failed `nodedown` against a gateway that was plainly running. A name that only the
# start path knows is not a name.
#
# Those commands find the node by NAME, so they must run in an environment that resolves
# to the SAME name the gateway was started under. Three inputs decide it, in this order:
# `RELEASE_NODE`, then `TIGHTBEAM_NODE`, then `TIGHTBEAM_PORT`. State it as the whole
# environment rather than as a list of variables to remember — twice now a shorter
# version of this sentence has been WRONG by omission ("the same port", then "the port or
# TIGHTBEAM_NODE"), each time describing a guarantee this script does not give.
#
# A LEADING FLAG STILL MEANS `start`. The previous form was `start "$@"`, so
# `tightbeam-gateway --erl "+sbwt none"` passed that option to start; treating a
# leading `-` as a subcommand would answer it with `Unknown command --erl`. Only a
# bare word is a subcommand.
case "${1:-}" in
  "" | -*) set -- start "$@" ;;
esac

exec "$DIR/release/bin/tightbeam_gateway" "$@"
