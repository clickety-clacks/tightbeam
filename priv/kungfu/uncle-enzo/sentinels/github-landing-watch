#!/usr/bin/env python3
"""Poll GitHub for explicitly demanded Uncle Enzo sentinel events."""

from __future__ import annotations

import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse

POLL_SECONDS = 60
MAX_BACKOFF_SECONDS = 900
CLAIM_RENEW_SECONDS = 900
GH_TIMEOUT = 120
TIGHTBEAM_TIMEOUT = 60

SETTLED = "landing.settled"
PREFIX = "uncle-enzo/"
BRANCH_ATTENTION = "landing.branch-attention"
CHECKS_COMPLETED = "pr.checks-completed"

CHECK_RUN_PASSING = {"SUCCESS", "NEUTRAL", "SKIPPED"}
CHECK_RUN_FAILING = {"FAILURE", "CANCELLED", "TIMED_OUT", "STARTUP_FAILURE", "ACTION_REQUIRED", "STALE"}
STATUS_FAILING = {"FAILURE", "ERROR"}

EXIT_SETTINGS = 2

NAME = r"[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_])?"
PR_SCOPE = re.compile(r"^(" + NAME + r")/([A-Za-z0-9._-]+)#([1-9][0-9]*)$")
BRANCH_SCOPE = re.compile(r"^(" + NAME + r")/([A-Za-z0-9._-]+)@([^\s=@]+)$")

ROLLUP_NODES = """
          __typename
          ... on CheckRun {
            id name status conclusion startedAt completedAt detailsUrl %(required)s
            checkSuite { app { databaseId } }
          }
          ... on StatusContext {
            id context state createdAt targetUrl %(required)s
          }
"""

Q_PULL = """
query LandingPull($owner: String!, $name: String!, $number: Int!, $since: DateTime, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      number state merged mergeCommit { oid } headRefOid baseRefName
      autoMergeRequest { enabledAt }
      mergeQueueEntry { id }
      timelineItems(itemTypes: [REMOVED_FROM_MERGE_QUEUE_EVENT, AUTO_MERGE_DISABLED_EVENT, CLOSED_EVENT],
                    since: $since, first: 100, after: $cursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          __typename
          ... on RemovedFromMergeQueueEvent { id createdAt reason }
          ... on AutoMergeDisabledEvent { id createdAt }
          ... on ClosedEvent { id createdAt }
        }
      }
    }
  }
}
"""

Q_PULL_CHECKS = """
query LandingPullChecks($owner: String!, $name: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      commits(last: 1) {
        nodes {
          commit {
            oid
            statusCheckRollup {
              contexts(first: 100, after: $cursor) {
                pageInfo { hasNextPage endCursor }
                nodes {%s}
              }
            }
          }
        }
      }
    }
  }
}
""" % (ROLLUP_NODES % {"required": "isRequired(pullRequestNumber: $number)"})

Q_MERGE_CHECKS = """
query LandingMergeChecks($owner: String!, $name: String!, $number: Int!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      potentialMergeCommit {
        oid
        parents(first: 2) { nodes { oid } }
        statusCheckRollup {
          contexts(first: 100, after: $cursor) {
            pageInfo { hasNextPage endCursor }
            nodes {%s}
          }
        }
      }
    }
  }
}
""" % (ROLLUP_NODES % {"required": "isRequired(pullRequestNumber: $number)"})

Q_TIP = """
query LandingTip($owner: String!, $name: String!, $qualified: String!, $cursor: String) {
  repository(owner: $owner, name: $name) {
    ref(qualifiedName: $qualified) {
      target {
        __typename
        ... on Commit {
          oid
          statusCheckRollup {
            contexts(first: 100, after: $cursor) {
              pageInfo { hasNextPage endCursor }
              nodes {%s}
            }
          }
        }
      }
    }
  }
}
""" % (ROLLUP_NODES % {"required": ""})


class ReadError(Exception):
    """A GitHub read that did not return complete, usable data."""


def now_utc() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0)


def iso(moment: dt.datetime) -> str:
    return moment.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


class Branch:
    def __init__(self, owner: str, repo: str, branch: str):
        self.owner = owner
        self.repo = repo
        self.branch = branch


class Runner:
    """Runs gh and tightbeam. Tests replace it with a fake."""

    def __init__(self, as_process: str | None):
        self.as_process = as_process
        self.last_claim_at = None

    def _gh(self, args: list[str]) -> str:
        try:
            done = subprocess.run(
                ["gh", *args],
                capture_output=True,
                text=True,
                timeout=GH_TIMEOUT,
                env={**os.environ, "GH_PROMPT_DISABLED": "1", "GH_NO_UPDATE_NOTIFIER": "1"},
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise ReadError(f"gh failed: {error}") from error
        if done.returncode != 0:
            raise ReadError(f"gh exited {done.returncode}: {one_line(done.stderr or done.stdout)}")
        return done.stdout

    def graphql(self, query: str, variables: dict) -> dict:
        renew_claim(self)
        args = ["api", "graphql", "-f", f"query={query}"]
        for key, value in variables.items():
            if value is None:
                continue
            flag = "-F" if isinstance(value, int) else "-f"
            args += [flag, f"{key}={value}"]
        try:
            body = json.loads(self._gh(args))
        except json.JSONDecodeError as error:
            raise ReadError(f"gh returned malformed JSON: {error}") from error
        if not isinstance(body, dict) or body.get("errors") or not isinstance(body.get("data"), dict):
            raise ReadError(f"graphql response incomplete: {one_line(json.dumps(body.get('errors') if isinstance(body, dict) else body))}")
        return body["data"]

    def rest(self, path: str):
        renew_claim(self)
        try:
            return json.loads(self._gh(["api", path]))
        except json.JSONDecodeError as error:
            raise ReadError(f"gh returned malformed JSON: {error}") from error

    def tightbeam(self, args: list[str]) -> tuple[bool, str]:
        try:
            renew_claim(self)
        except ReadError as error:
            print(f"claim renewal failed before filing: {error}", file=sys.stderr)
        argv = ["tightbeam", *args]
        if self.as_process:
            argv += ["--as-process", self.as_process]
        try:
            done = subprocess.run(argv, capture_output=True, text=True, timeout=TIGHTBEAM_TIMEOUT)
        except (OSError, subprocess.TimeoutExpired) as error:
            return False, str(error)
        return done.returncode == 0, one_line(done.stderr if done.returncode else done.stdout)

    def tightbeam_json(self, args: list[str]) -> dict:
        argv = ["tightbeam", *args]
        if self.as_process:
            argv += ["--as-process", self.as_process]
        try:
            done = subprocess.run(argv, capture_output=True, text=True, timeout=TIGHTBEAM_TIMEOUT)
        except (OSError, subprocess.TimeoutExpired) as error:
            raise ReadError(f"tightbeam failed: {error}") from error
        if done.returncode:
            raise ReadError(f"tightbeam exited {done.returncode}: {one_line(done.stderr)}")
        try:
            value = json.loads(done.stdout)
        except json.JSONDecodeError as error:
            raise ReadError(f"tightbeam returned malformed JSON: {error}") from error
        if not isinstance(value, dict):
            raise ReadError("tightbeam returned a non-object")
        return value


def one_line(text: str) -> str:
    return " ".join((text or "").split())[:500]


def dig(data, *path):
    """Walk required objects; a missing or null object is an incomplete read."""
    node = data
    for key in path:
        if not isinstance(node, dict) or node.get(key) is None:
            raise ReadError("null node at " + ".".join(path))
        node = node[key]
    return node


def page_info(connection) -> tuple[bool, str | None]:
    info = connection.get("pageInfo") if isinstance(connection, dict) else None
    if not isinstance(info, dict) or not isinstance(connection.get("nodes"), list):
        raise ReadError("connection without pageInfo or nodes")
    more = bool(info.get("hasNextPage"))
    cursor = info.get("endCursor")
    if more and not cursor:
        raise ReadError("page claims more results without a cursor")
    return more, cursor


def failing(result: dict) -> bool:
    if result["__typename"] == "CheckRun":
        return result.get("status") == "COMPLETED" and result.get("conclusion") in CHECK_RUN_FAILING
    return result.get("state") in STATUS_FAILING


def pending(result: dict) -> bool:
    if result["__typename"] == "CheckRun":
        return result.get("status") != "COMPLETED" or result.get("conclusion") not in (
            CHECK_RUN_PASSING | CHECK_RUN_FAILING
        )
    return result.get("state") not in (STATUS_FAILING | {"SUCCESS"})


def context_name(result: dict) -> str | None:
    return result.get("name") if result["__typename"] == "CheckRun" else result.get("context")


def check_identity(result: dict) -> str:
    if result["__typename"] == "CheckRun":
        return result["id"]
    return f"{result['context']}@{result['createdAt']}"


def result_time(result: dict) -> str:
    if result["__typename"] == "CheckRun":
        return result.get("startedAt") or result.get("completedAt") or ""
    return result.get("createdAt") or ""


def result_link(result: dict) -> str:
    return (result.get("detailsUrl") if result["__typename"] == "CheckRun" else result.get("targetUrl")) or ""


def latest_failure(results: list[dict]) -> dict | None:
    """The latest result decides a requirement; missing or pending is unknown.

    A pending result, such as a re-run that has not started, is treated as the
    latest one, since it can lack the timestamp that would order it.
    """
    if not results or any(pending(r) for r in results):
        return None
    latest = max(results, key=lambda r: (result_time(r), check_identity(r)))
    return latest if failing(latest) else None


def blocked_candidate(pull: dict) -> bool:
    auto = pull.get("autoMergeRequest")
    return (
        pull.get("merged") is False
        and pull.get("state") == "OPEN"
        and isinstance(auto, dict)
        and bool(auto.get("enabledAt"))
        and pull.get("mergeQueueEntry") is None
    )


def rollup_results(nodes: list) -> list[dict]:
    results = []
    for node in nodes:
        if not isinstance(node, dict) or node.get("__typename") not in ("CheckRun", "StatusContext"):
            continue
        if context_name(node) is None:
            continue
        results.append(node)
    return results


def source_of(result: dict):
    """The App ID of a check run, or None when the API cannot establish it."""
    if result["__typename"] != "CheckRun":
        return None
    app = (result.get("checkSuite") or {}).get("app") or {}
    return app.get("databaseId")


def tip_failures(requirements: list[dict], results: list[dict]) -> list[dict]:
    """Failing required checks on a tip, matched by context and configured source."""
    failures = []
    seen = set()
    for requirement in requirements:
        context = requirement["context"]
        integration = requirement.get("integration_id")
        named = [r for r in results if context_name(r) == context]
        if integration is None:
            matching = named
        else:
            if any(source_of(r) is None for r in named):
                continue  # A same-name result of unknown source could be the required one.
            matching = [r for r in named if source_of(r) == integration]
        # GitHub requires both a check run and a commit status to pass when
        # they share a required name. A newer success of one kind cannot hide
        # a failure of the other kind.
        for kind in ("CheckRun", "StatusContext"):
            failure = latest_failure([r for r in matching if r["__typename"] == kind])
            if failure and check_identity(failure) not in seen:
                seen.add(check_identity(failure))
                failures.append(failure)
    return failures


def pr_failures(results: list[dict]) -> list[dict]:
    """Failing required checks on GitHub's effective pull request subject."""
    required = [r for r in results if r.get("isRequired") is True]
    # A check run and a commit status with the same name are separate checks:
    # GitHub requires both to pass when that name is required.
    names = sorted({(r["__typename"], context_name(r)) for r in required})
    failures = []
    for kind, name in names:
        failure = latest_failure(
            [r for r in required if r["__typename"] == kind and context_name(r) == name]
        )
        if failure:
            failures.append(failure)
    return failures


def completed_checks(results: list[dict], requirements: list[dict]) -> tuple[str, str] | None:
    """Return pass or fail when every required check name has a terminal result."""
    required = [result for result in results if result.get("isRequired") is True]
    if not required or any(
        not any(
            context_name(result) == requirement["context"]
            and (requirement["integration_id"] is None or source_of(result) == requirement["integration_id"])
            for result in required
        )
        for requirement in requirements
    ):
        return None

    latest: dict[tuple[str, str], dict] = {}
    for result in required:
        name = (result["__typename"], context_name(result), source_of(result))
        current = latest.get(name)
        if current is None or (result_time(result), check_identity(result)) > (
            result_time(current),
            check_identity(current),
        ):
            latest[name] = result

    # A newly queued rerun may not have a timestamp yet; treat it as the latest
    # result for its name until it reaches a terminal state.
    for name in latest:
        pending_results = [
            result
            for result in required
            if (result["__typename"], context_name(result), source_of(result)) == name and pending(result)
        ]
        if pending_results:
            latest[name] = max(pending_results, key=lambda result: (result_time(result), check_identity(result)))

    if any(pending(result) for result in latest.values()):
        return None
    outcome = "fail" if any(failing(result) for result in latest.values()) else "pass"
    identities = sorted(check_identity(result) for result in latest.values())
    fingerprint = hashlib.sha256(json.dumps(identities).encode()).hexdigest()
    return outcome, fingerprint


class Log:
    def __init__(self, stream=sys.stderr):
        self.stream = stream
        self.episodes: set[str] = set()

    def line(self, text: str) -> None:
        print(f"{iso(now_utc())} {text}", file=self.stream, flush=True)

    def episode(self, key: str, text: str) -> None:
        if key not in self.episodes:
            self.episodes.add(key)
            self.line(text)


class Watcher:
    def __init__(self, branch: Branch, runner, log: Log):
        self.branch = branch
        self.runner = runner
        self.log = log

    # Reads

    def _repo_vars(self) -> dict:
        return {"owner": self.branch.owner, "name": self.branch.repo}

    def read_pull(self, number: int, since: dt.datetime | None, pull: dict) -> None:
        """Fill `pull` as far as reads succeed; raise ReadError when incomplete."""
        cursor = None
        events: list[dict] = pull.setdefault("events", [])
        while True:
            variables = {**self._repo_vars(), "number": number, "since": iso(since) if since else None, "cursor": cursor}
            node = dig(self.runner.graphql(Q_PULL, variables), "repository", "pullRequest")
            if "state" in pull and (pull["headRefOid"], pull["baseRefName"], pull["state"]) != (
                node.get("headRefOid"), node.get("baseRefName"), node.get("state")
            ):
                raise ReadError(f"pull request {number} moved while reading its timeline")
            if "state" not in pull:
                for field in ("state", "merged", "mergeCommit", "headRefOid", "baseRefName", "autoMergeRequest", "mergeQueueEntry"):
                    pull[field] = node.get(field)
                merge = pull.get("mergeCommit") or {}
                if pull.get("merged") is True and merge.get("oid") and (
                    not isinstance(pull.get("headRefOid"), str) or not pull["headRefOid"] or
                    not isinstance(pull.get("baseRefName"), str) or not pull["baseRefName"]
                ):
                    raise ReadError(f"pull request {number} merge record lacks branch or head commit")
            connection = node.get("timelineItems")
            if connection is None:
                raise ReadError(f"pull request {number} timeline is null")
            more, cursor = page_info(connection)
            for event in connection["nodes"]:
                if not isinstance(event, dict) or not event.get("id"):
                    raise ReadError(f"pull request {number} timeline returned a null node")
                events.append(event)
            if not more:
                return

    def read_pull_checks(self, number: int, head: str) -> list[dict] | None:
        """Use test-merge statuses when present; otherwise use head statuses.

        A missing or stale test merge is unknown, never evidence of a blocked PR.
        """
        cursor = None
        oid = None
        head_results: list[dict] = []
        while True:
            data = self.runner.graphql(Q_PULL_CHECKS, {**self._repo_vars(), "number": number, "cursor": cursor})
            commits = dig(data, "repository", "pullRequest", "commits").get("nodes")
            if not commits:
                return None
            commit = dig(commits[0], "commit")
            if oid is not None and commit.get("oid") != oid:
                raise ReadError(f"pull request {number} head moved while reading checks")
            oid = commit.get("oid")
            if oid != head:
                return None
            rollup = commit.get("statusCheckRollup")
            if rollup is None:
                break
            connection = rollup.get("contexts")
            more, cursor = page_info(connection)
            head_results += rollup_results(connection["nodes"])
            if not more:
                break

        cursor = None
        merge_oid = None
        merge_results: list[dict] = []
        while True:
            data = self.runner.graphql(Q_MERGE_CHECKS, {**self._repo_vars(), "number": number, "cursor": cursor})
            merge = dig(data, "repository", "pullRequest").get("potentialMergeCommit")
            if merge is None or not merge.get("oid"):
                return None
            if merge_oid is not None and merge["oid"] != merge_oid:
                raise ReadError(f"pull request {number} test merge moved while reading checks")
            merge_oid = merge["oid"]
            parents = dig(merge, "parents").get("nodes")
            if not isinstance(parents, list) or head not in [
                parent.get("oid") for parent in parents if isinstance(parent, dict)
            ]:
                return None
            rollup = merge.get("statusCheckRollup")
            if rollup is None:
                return head_results
            connection = rollup.get("contexts")
            more, cursor = page_info(connection)
            merge_results += rollup_results(connection["nodes"])
            if not more:
                return merge_results if merge_results else head_results

    def read_head_checks(self, number: int, head: str) -> list[dict] | None:
        """Read required check results only if the pull request still has this head."""
        cursor = None
        results: list[dict] = []
        while True:
            data = self.runner.graphql(Q_PULL_CHECKS, {**self._repo_vars(), "number": number, "cursor": cursor})
            commits = dig(data, "repository", "pullRequest", "commits").get("nodes")
            if not commits:
                return None
            commit = dig(commits[0], "commit")
            if commit.get("oid") != head:
                return None
            rollup = commit.get("statusCheckRollup")
            if rollup is None:
                return None
            connection = rollup.get("contexts")
            more, cursor = page_info(connection)
            results += rollup_results(connection["nodes"])
            if not more:
                return results

    def read_tip(self) -> tuple[str, list[dict]]:
        cursor = None
        oid = None
        results: list[dict] = []
        while True:
            variables = {**self._repo_vars(), "qualified": f"refs/heads/{self.branch.branch}", "cursor": cursor}
            target = dig(self.runner.graphql(Q_TIP, variables), "repository", "ref", "target")
            if target.get("__typename") != "Commit" or not target.get("oid"):
                raise ReadError("branch tip is not a commit")
            if oid is not None and target["oid"] != oid:
                raise ReadError("branch tip moved while reading checks")
            oid = target["oid"]
            rollup = target.get("statusCheckRollup")
            if rollup is None:
                return oid, []
            connection = rollup.get("contexts")
            more, cursor = page_info(connection)
            results += rollup_results(connection["nodes"])
            if not more:
                return oid, results

    def read_requirements(self) -> list[dict]:
        branch = urllib.parse.quote(self.branch.branch, safe="/")
        requirements: list[dict] = []
        page = 1
        while True:
            rules = self.runner.rest(
                f"repos/{self.branch.owner}/{self.branch.repo}/rules/branches/{branch}?per_page=100&page={page}"
            )
            if not isinstance(rules, list):
                raise ReadError("branch rules response is not a list")
            for rule in rules:
                if not isinstance(rule, dict) or rule.get("type") != "required_status_checks":
                    continue
                checks = (rule.get("parameters") or {}).get("required_status_checks")
                if not isinstance(checks, list):
                    raise ReadError("required_status_checks rule without its checks")
                for check in checks:
                    if not isinstance(check, dict) or not isinstance(check.get("context"), str):
                        raise ReadError("required status check without a context")
                    requirements.append({"context": check["context"], "integration_id": check.get("integration_id")})
            if len(rules) < 100:
                return requirements
            page += 1

    def condition(self, kind: str, scope: str, key: str, **details: str) -> bool:
        args = ["sentinel", "post", "--event", PREFIX + kind, "--key", key,
                "--detail", f"scope={scope}"]
        for name, value in details.items():
            args.extend(["--detail", f"{name}={value}"])
        ok, detail = self.runner.tightbeam(args)
        if not ok:
            self.log.line(f"refused fact key={key} reason={detail}")
        return ok


def demanded_scopes(runner, log: Log) -> tuple[dict[str, set[str]], dict[str, set[str]]]:
    data = runner.tightbeam_json(["sentinel", "demand", "--kind-prefix", PREFIX])
    pairs = data.get("demand")
    if not isinstance(pairs, list):
        raise ReadError("sentinel demand returned no demand array")
    prs: dict[str, set[str]] = {}
    branches: dict[str, set[str]] = {}
    served = {SETTLED, CHECKS_COMPLETED, BRANCH_ATTENTION}
    for pair in pairs:
        if not isinstance(pair, dict) or not isinstance(pair.get("kind"), str):
            raise ReadError("sentinel demand returned a malformed pair")
        kind, filters = pair["kind"], pair.get("filter")
        if not isinstance(filters, dict):
            raise ReadError("sentinel demand returned a malformed filter")
        if not kind.startswith(PREFIX):
            continue
        kind = kind.removeprefix(PREFIX)
        if kind not in served:
            continue
        scopes = filters.get("scope", [None])
        if not isinstance(scopes, list):
            raise ReadError("sentinel demand returned malformed scope alternatives")
        pattern = BRANCH_SCOPE if kind == BRANCH_ATTENTION else PR_SCOPE
        for scope in scopes:
            if not isinstance(scope, str) or not pattern.fullmatch(scope):
                log.episode(f"invalid-demand:{kind}:{scope}", f"ignored invalid demand kind={kind} scope={scope!r}")
                continue
            (branches if kind == BRANCH_ATTENTION else prs).setdefault(scope, set()).add(kind)
    return prs, branches


def renew_claim(runner, force: bool = False) -> None:
    now = time.monotonic()
    last = getattr(runner, "last_claim_at", None)
    if not force and last is not None and now - last < CLAIM_RENEW_SECONDS:
        return
    runner.tightbeam_json([
        "fact-producer-claim", "--producer", "uncle-enzo/github-landing-watch",
        "--kind", PREFIX + SETTLED, "--kind", PREFIX + CHECKS_COMPLETED,
        "--kind", PREFIX + BRANCH_ATTENTION,
        "--live-for", "1h",
    ])
    runner.last_claim_at = time.monotonic()


def unavailable_scope(error: ReadError) -> bool:
    detail = str(error)
    return any(marker in detail for marker in (
        "null node at repository.pullRequest",
        "null node at repository.ref",
        "HTTP 404",
        "Could not resolve to a Repository",
        "Could not resolve to a PullRequest",
        "Resource not accessible",
    ))


def poll_demanded_pr(scope: str, kinds: set[str], runner, log: Log) -> bool:
    owner, repo, number_text = PR_SCOPE.fullmatch(scope).groups()
    number = int(number_text)
    watcher = Watcher(Branch(owner, repo, ""), runner, log)
    pull: dict = {}
    try:
        watcher.read_pull(number, None, pull)
        if SETTLED in kinds and blocked_candidate(pull):
            pull["checks"] = watcher.read_pull_checks(number, pull["headRefOid"])
        head = pull.get("headRefOid")
        if CHECKS_COMPLETED in kinds and pull.get("state") == "OPEN" and pull.get("mergeQueueEntry") is None and head:
            pull["head_checks"] = watcher.read_head_checks(number, head)
            base = pull.get("baseRefName")
            if pull["head_checks"] is not None and isinstance(base, str) and base:
                watcher.branch.branch = base
                pull["requirements"] = watcher.read_requirements()
    except ReadError as error:
        log.line(f"unreadable demanded pr={scope} reason={error}")
        return unavailable_scope(error)

    ok = True
    merge = pull.get("mergeCommit") or {}
    if pull.get("merged") is True and merge.get("oid"):
        if SETTLED in kinds:
            ok &= watcher.condition(
                SETTLED, scope, f"enzo-landing:{scope}:merged:{merge['oid']}",
                outcome="merged", head=pull["headRefOid"], base=pull["baseRefName"],
                commit=merge["oid"], evidence=f"https://github.com/{owner}/{repo}/pull/{number}",
            )

    if SETTLED in kinds:
        for event in pull.get("events", []):
            event_kind = event.get("__typename")
            if event_kind == "RemovedFromMergeQueueEvent":
                suffix = f"removed:{event['id']}"
            elif pull.get("merged") is False and event_kind == "AutoMergeDisabledEvent":
                suffix = f"automerge-disabled:{event['id']}"
            elif pull.get("merged") is False and event_kind == "ClosedEvent":
                suffix = f"closed:{event['id']}"
            else:
                continue
            ok &= watcher.condition(SETTLED, scope, f"enzo-landing:{scope}:{suffix}:{pull.get('headRefOid')}:{pull.get('baseRefName')}", outcome=suffix.split(":", 1)[0],
                                    head=pull.get("headRefOid") or "", base=pull.get("baseRefName") or "",
                                    commit="", evidence=f"https://github.com/{owner}/{repo}/pull/{number}")
        if blocked_candidate(pull) and pull.get("checks") is not None:
            for failure in pr_failures(pull["checks"]):
                key = f"landing-fact:{scope}:blocked:{pull['autoMergeRequest']['enabledAt']}:{check_identity(failure)}"
                ok &= watcher.condition(SETTLED, scope, "enzo-" + key, outcome="blocked",
                                        head=head, base=pull["baseRefName"], commit="",
                                        evidence=result_link(failure) or f"https://github.com/{owner}/{repo}/pull/{number}")
    if CHECKS_COMPLETED in kinds and head and "requirements" in pull:
        completed = completed_checks(pull["head_checks"], pull["requirements"])
        if completed is not None:
            outcome, fingerprint = completed
            ok &= watcher.condition(CHECKS_COMPLETED, scope, f"enzo-checks:{scope}:{head}:{outcome}:{fingerprint}", head=head, outcome=outcome,
                                    evidence=f"https://github.com/{owner}/{repo}/pull/{number}/checks")
    return ok


def poll_branch(scope: str, runner, log: Log) -> bool:
    owner, repo, branch = BRANCH_SCOPE.fullmatch(scope).groups()
    watcher = Watcher(Branch(owner, repo, branch), runner, log)
    try:
        tip, results = watcher.read_tip()
        requirements = watcher.read_requirements()
    except ReadError as error:
        log.line(f"unreadable branch={scope} reason={error}")
        return unavailable_scope(error)
    ok = True
    for failure in tip_failures(requirements, results):
        episode = f"{scope}:red:{tip}:{check_identity(failure)}"
        ok &= watcher.condition(BRANCH_ATTENTION, scope, f"enzo-landing:{episode}", head=tip,
                                check=context_name(failure),
                                evidence=result_link(failure) or f"https://github.com/{owner}/{repo}/commit/{tip}")
    return ok


def run(argv, env, runner=None, log=None, sleep=time.sleep) -> int:
    log = log or Log()
    once = "--once" in argv[1:]
    unknown = [a for a in argv[1:] if a != "--once"]
    if unknown:
        log.line(f"exit reason=unknown arguments {' '.join(unknown)}")
        return EXIT_SETTINGS
    if runner is None:
        config = env.get("GH_CONFIG_DIR", "")
        if not os.path.isdir(config):
            log.line("GH_CONFIG_DIR must identify the configured GitHub CLI directory")
            return EXIT_SETTINGS
        runner = Runner(env.get("TIGHTBEAM_AS_PROCESS", "sentinel:uncle-enzo/github-landing-watch"))

    failures = 0
    while True:
        complete = True
        try:
            renew_claim(runner, force=True)
            prs, demanded_branches = demanded_scopes(runner, log)
        except ReadError as error:
            complete = False
            log.line(f"poll failed reason={error}")
        else:
            try:
                for scope, kinds in prs.items():
                    renew_claim(runner)
                    complete &= poll_demanded_pr(scope, kinds, runner, log)
                for scope in demanded_branches:
                    renew_claim(runner)
                    complete &= poll_branch(scope, runner, log)
            except ReadError as error:
                complete = False
                log.line(f"poll failed reason={error}")
        if once:
            return 0 if complete else 1
        failures = 0 if complete else failures + 1
        sleep(min(POLL_SECONDS * (2 ** min(failures, 4)), MAX_BACKOFF_SECONDS))


if __name__ == "__main__":
    sys.exit(run(sys.argv, os.environ))
