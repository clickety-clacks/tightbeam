#!/bin/sh
input=$(cat)
holder_workdir=$(printf '%s' "$input" | jq -r '.context.holder_workdir')
[ "$(realpath "$holder_workdir")" = "$(pwd -P)" ] || exit 71
printf '%s' "$input" | jq -e '.context | has("repo") | not' >/dev/null || exit 72
declared=$(printf '%s' "$input" | jq -r '.params.files[]?' | sort)
observed=$(git diff --name-only main...HEAD | sort)
if [ "$declared" = "$observed" ]; then
  printf '%s\n' within-declared
else
  printf '%s\n' outside-declared
fi
