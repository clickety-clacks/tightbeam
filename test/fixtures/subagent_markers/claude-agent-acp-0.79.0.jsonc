// Protocol contract fixture for @agentclientprotocol/claude-agent-acp 0.79.0 ACP updates.
// Right-sizing: assert only consumed fields and relied-on invariants; additive unconsumed fields must not fail.
{
  "adapter": "@agentclientprotocol/claude-agent-acp",
  "version": "0.79.0",
  "semantic": {
    "spawn_operation_terminal": "subagent_spawned announces the child session before its independent lifecycle",
    "child_termination_terminal": "subagent_state_update reports the child settlement"
  },
  "live_agent_started": {
    "sessionUpdate": "subagent_spawned",
    "subagentSessionId": "claude-child-1",
    "name": "Agent",
    "task": "Review the implementation",
    "capabilities": {}
  },
  "live_task_started": {
    "sessionUpdate": "subagent_spawned",
    "subagentSessionId": "claude-task-child-1",
    "name": "Task",
    "task": "Check the proof",
    "capabilities": {}
  },
  "spawn_operation_terminal": {
    "sessionUpdate": "tool_call_update",
    "toolCallId": "call-claude-1",
    "status": "completed",
    "_meta": {
      "claudeCode": {
        "toolName": "Agent"
      }
    }
  },
  "patched_termination": {
    "sessionUpdate": "subagent_state_update",
    "subagentSessionId": "claude-child-1",
    "state": "completed"
  },
  "load_replay_agent_started": {
    "sessionUpdate": "tool_call",
    "toolCallId": "call-claude-replayed",
    "status": "completed",
    "_meta": {
      "claudeCode": {
        "toolName": "Agent"
      }
    }
  }
}
