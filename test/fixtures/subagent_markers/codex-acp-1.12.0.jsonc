// Protocol contract fixture for @agentclientprotocol/codex-acp 1.12.0 ACP updates.
// Right-sizing: assert only consumed fields and relied-on invariants; additive unconsumed fields must not fail.
{
  "adapter": "@agentclientprotocol/codex-acp",
  "version": "1.12.0",
  "semantic": {
    "spawn_operation_terminal": "subagent_spawned announces the child session while it remains independently live",
    "child_termination_terminal": "subagent_state_update reports the correlated child entering completed"
  },
  "live_started": {
    "sessionUpdate": "subagent_spawned",
    "subagentSessionId": "thread-child-1",
    "name": "reviewer",
    "task": "Review the implementation",
    "capabilities": {}
  },
  "spawn_operation_terminal": {
    "sessionUpdate": "tool_call_update",
    "toolCallId": "call-codex-1",
    "status": "completed",
    "_meta": {
      "codex": {
        "subagent": {
          "threadId": "thread-child-1",
          "path": "root/reviewer",
          "activity": "started"
        }
      }
    }
  },
  "live_interacted": {
    "sessionUpdate": "tool_call",
    "toolCallId": "call-codex-message-1",
    "status": "in_progress",
    "_meta": {
      "codex": {
        "subagent": {
          "threadId": "thread-child-1",
          "path": "root/reviewer",
          "activity": "interacted"
        }
      }
    }
  },
  "live_interrupted": {
    "sessionUpdate": "tool_call",
    "toolCallId": "call-codex-interrupt-1",
    "status": "in_progress",
    "_meta": {
      "codex": {
        "subagent": {
          "threadId": "thread-child-1",
          "path": "root/reviewer",
          "activity": "interrupted"
        }
      }
    }
  },
  "patched_termination": {
    "sessionUpdate": "subagent_state_update",
    "subagentSessionId": "thread-child-1",
    "state": "completed"
  },
  "load_replay_completed_started": {
    "sessionUpdate": "subagent_spawned",
    "subagentSessionId": "thread-child-replayed",
    "name": "replayed-reviewer",
    "task": "Reconstruct the child"
  }
}
